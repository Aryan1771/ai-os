[Unit]
Description=AI-OS local settings panel
After=network.target

[Service]
Type=simple
Environment=AI_OS_HOME=%h/.ai_os
WorkingDirectory=%h/src/ai-os
ExecStart=%h/.ai_os/venv/bin/python -m ai_os.settings_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.ai_os %h/.local/share/ai_os

[Install]
WantedBy=default.target
