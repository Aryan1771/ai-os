[Unit]
Description=REgenOS pixel companion overlay
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=AI_OS_HOME=%h/.ai_os
WorkingDirectory=%h/src/ai-os
ExecStart=%h/.ai_os/venv/bin/python -m ai_os.avatar_overlay
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full

[Install]
WantedBy=graphical-session.target
