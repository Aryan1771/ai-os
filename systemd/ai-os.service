[Unit]
Description=AI-OS Interface Layer Daemon
After=network-online.target ollama.service pipewire.service
Wants=network-online.target

[Service]
Type=simple
Environment=AI_OS_HOME=%h/.ai_os
WorkingDirectory=%h/src/ai-os-interface-layer
ExecStart=%h/.ai_os/venv/bin/python -m ai_os.ai_os_core
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.ai_os %h/.local/share/ai_os %h/Downloads

[Install]
WantedBy=default.target

